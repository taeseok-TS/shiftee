generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── 직원 ───────────────────────────────────────────────────
model User {
  id                   String           @id @default(cuid())
  email                String           @unique
  password             String
  name                 String
  phone                String?
  role                 Role             @default(EMPLOYEE)
  isSuperAdmin         Boolean          @default(false) // 메인(최고) 관리자 여부. 시스템 설정/관리자 계정 관리 전용
  empNo                Int?             @unique // 사원번호 4자리(순차 1001~)
  leaveNote            String? // 근속 관련 별도 표기(육아휴직 등 장기 미근무)
  department           String?
  jobGroup             String? // 직군 (원장 | CM | TM | 코디)
  position             String? // 직급 (인턴매니저, 주임교실장 등)
  branch               String? // 지점 (예: "A지점", "B지점")
  avatarUrl            String? // 프로필 사진 URL (없으면 이니셜 아바타)
  birthDate            DateTime? @db.Date // 생일 (봇 브리핑 생일 축하용)
  address              String? // 주소 (전자계약 자동 채움 — 서명 시 비어 있으면 직원이 입력→저장)
  notifyApproval       Boolean   @default(true) // 결재 결과 알림(봇 DM+푸시) 수신 여부 — 본인 설정 (관리자 강제발송 시 무시)
  passwordResetAt      DateTime? // 관리자가 임시 비번(1234)으로 초기화한 시각. 본인이 비번을 바꾸면 null (24h 경과 시 봇이 변경 요청 알림)
  hireDate             DateTime?
  isActive             Boolean          @default(true)
  employmentStatus     EmploymentStatus @default(ACTIVE)
  resignDate           DateTime?
  resignReason         String?
  deletedAt            DateTime? // 삭제된 시간 (soft delete)
  permanentlyDeletedAt DateTime? // 영구 삭제 예정 시간 (30일 후)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  attendances           Attendance[]
  schedules             Schedule[]
  leaveRequests         LeaveRequest[]
  leaveBalance          LeaveBalance[] // 연도별 1행 (@@unique([userId, year]))
  contracts             Contract[]
  approvedLeaves        LeaveRequest[]         @relation("Approver")
  approvalLines         ApprovalLine[]         @relation("ApprovalLineTarget")
  approvalLineSteps     ApprovalLineStep[]     @relation("ApprovalLineApprover")
  leaveApprovalSteps    LeaveApprovalStep[]    @relation("LeaveApprovalApprover")
  scheduleApprovalSteps ScheduleApprovalStep[] @relation("ScheduleApprovalApprover")
  contractApprovalSteps ContractApprovalStep[] @relation("ContractApprover")
  scheduleRequests      ScheduleRequest[]
  contractTemplates     ContractTemplate[]     @relation("TemplateCreator")
  contractVersions      ContractVersion[]      @relation("VersionCreator")
  workChannelMembers    WorkChannelMember[]
  workMessages          WorkMessage[]
  workAnnouncements     WorkAnnouncement[]
  workMessageReactions  WorkMessageReaction[]
  pushTokens            PushToken[]
  device                UserDevice?
  managerBranches       ManagerBranch[] // 원장 겸직 지점 (대표 지점 User.branch 외 추가 담당)
  workBookmarks         WorkBookmark[]
  scheduledMessages     WorkScheduledMessage[]
  reminders             WorkReminder[]
}

// 직원 1인 1기기 등록 — 미등록 기기에서 앱 로그인/출퇴근 차단(대리 출퇴근 방지). 관리자(ADMIN)는 예외.
model UserDevice {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId   String
  deviceName String?
  platform   String?
  createdAt  DateTime @default(now())
}

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE // 재직 중
  RESIGNED // 퇴직
  ON_LEAVE // 휴직
  TEMPORARY // 임시휴무
}

// ─── 출퇴근 ─────────────────────────────────────────────────
model Attendance {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  date      DateTime         @db.Date
  clockIn   DateTime?
  clockOut  DateTime?
  status    AttendanceStatus @default(NORMAL)
  note      String?
  latitude  Float?
  longitude Float?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
}

enum AttendanceStatus {
  NORMAL // 정상
  LATE // 지각
  EARLY_LEAVE // 조기퇴근
  ABSENT // 결근
  HOLIDAY // 휴일
}

// ─── 근무일정 ───────────────────────────────────────────────
model Schedule {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  date      DateTime     @db.Date
  startTime String // "09:00"
  endTime   String // "18:00"
  type      ScheduleType @default(WORK)
  note      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId, date])
}

enum ScheduleType {
  WORK // 근무
  OFF // 휴무
  HOLIDAY // 공휴일
}

// ─── 근무일정 신청 ──────────────────────────────────────────
model ScheduleRequest {
  id            String                 @id @default(cuid())
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  templateId    String? // 근무 템플릿 ID (예: "10-7")
  templateName  String? // 템플릿명 (예: "10AM-7PM")
  startDate     DateTime               @db.Date
  endDate       DateTime               @db.Date
  scheduleData  Json // 날짜별 일정 데이터
  totalHours    Float // 총 계획 근무시간
  status        ScheduleRequestStatus  @default(PENDING)
  reason        String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  approvalSteps ScheduleApprovalStep[]

  @@index([userId, status])
}

enum ScheduleRequestStatus {
  PENDING // 대기
  APPROVED // 승인
  REJECTED // 반려
  CANCELLED // 취소
}

// ─── 근무일정 신청 결재 현황 ──────────────────────────────────
// ─── 근무일정 신청 결재 현황 ──────────────────────────────────
model ScheduleApprovalStep {
  id                String             @id @default(cuid())
  scheduleRequestId String
  scheduleRequest   ScheduleRequest    @relation(fields: [scheduleRequestId], references: [id], onDelete: Cascade)
  order             Int
  approverId        String? // 실제 결재한 사람(역할기반 단계는 승인 시 기록). null=아직 미결
  approver          User?              @relation("ScheduleApprovalApprover", fields: [approverId], references: [id])
  approverRole      String? // 이 단계를 결재할 역할: MANAGER | ADMIN (역할 기반 정책)
  branch            String? // MANAGER 단계일 때 해당 지점
  status            ApprovalStepStatus @default(PENDING)
  comment           String?
  decidedAt         DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([scheduleRequestId, order])
  @@index([approverId, status])
}

// ─── 휴가 ───────────────────────────────────────────────────
model LeaveRequest {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id])
  approverId     String?
  approver       User?               @relation("Approver", fields: [approverId], references: [id])
  type           LeaveType
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  days           Float
  reason         String?
  attachmentUrl  String? // 첨부(대체휴무 동의서 등). 모든 유형 선택, 대체휴무는 필수
  attachmentName String?
  status         LeaveStatus         @default(PENDING)
  rejectedReason String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  approvalSteps  LeaveApprovalStep[]

  @@index([userId, status])
}

enum LeaveType {
  ANNUAL // 연차
  HALF_AM // 오전 반차 (0.5일)
  HALF_PM // 오후 반차 (0.5일)
  QUARTER_AM // 오전 반반차 (0.25일)
  QUARTER_PM // 오후 반반차 (0.25일)
  COMPENSATORY // 대체휴무
  COMPENSATORY_HALF // 대체휴무반차 (0.5일)
  SICK // 병가
  SPECIAL // 특별휴가
  CIVIL_DEFENSE // 민방위 (0.5일, 연차 미차감)
  RESERVE_FORCES // 예비군훈련 (연차 미차감)
  FAMILY_EVENT // 경조사(기타)
  FAMILY_MARRIAGE // 경조사-결혼 (연차 미차감)
  FAMILY_BIRTH // 경조사-출산 (연차 미차감)
  FAMILY_BEREAVEMENT // 경조사-사망(조사) (연차 미차감)
}

enum LeaveStatus {
  PENDING // 대기
  APPROVED // 승인
  REJECTED // 반려
  CANCELLED // 취소
}

model LeaveBalance {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  year      Int
  total     Float    @default(15)
  used      Float    @default(0)
  remaining Float    @default(15)
  updatedAt DateTime @updatedAt

  // 연도별 이력 보관 — 유저당 연 1행 (연차 연도 전환 지원)
  @@unique([userId, year])
}

// ─── 전자 계약 ──────────────────────────────────────────────
model Contract {
  id               String                @id @default(cuid())
  userId           String
  user             User                  @relation(fields: [userId], references: [id])
  templateId       String?
  template         ContractTemplate?     @relation("TemplateToContract", fields: [templateId], references: [id], onDelete: SetNull)
  title            String
  type             ContractType
  fileUrl          String
  signedUrl        String?
  version          Int                   @default(1)
  status           ContractStatus        @default(DRAFT)
  startDate        DateTime?             @db.Date
  endDate          DateTime?             @db.Date
  extraFields      Json? // 작성 시 입력값 요약(연봉·템플릿 동적 필드, 표시용 포맷) — 결재 승인 창에 표시
  revocationLog    Json? // 결재/서명 회수 이력 [{type, reason, revokedBy, revokedAt}, ...]
  hideRevoked      Boolean               @default(false) // 회수된 계약 목록 숨김 토글
  bundleId         String? // 신규입사 패키지 묶음 ID(근로계약서+비밀유지+개인정보동의서 함께 발송)
  employeeOnly     Boolean               @default(false) // 직원 서명만·직원+관리자에게만 표시(비밀유지·개인정보동의서)
  profileFields    Json? // 이 계약서가 쓰는 직원 프로필 필드(["주소","생년월일"]) — 서명 시 비어 있으면 입력 유도
  employeeFields   Json? // 직원이 서명 시 직접 입력하는 문서 전용 필드(["퇴사일자","퇴사사유"]) — 프로필 저장 X, 문서에만 반영
  employeeSignedAt DateTime?
  signedAt         DateTime?
  approvalLine     ContractApprovalLine?
  versions         ContractVersion[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

enum ContractType {
  EMPLOYMENT // 근로계약서
  PART_TIME // 단시간근로계약서
  CONFIDENTIAL // 비밀유지계약
  OTHER
}

enum ContractStatus {
  DRAFT // 초안
  SENT // 발송됨
  APPROVED // 승인 중
  SIGNED // 서명완료
  EXPIRED // 만료
}

// ─── 계약 결재 라인 ──────────────────────────────────────────
model ContractApprovalLine {
  id         String                 @id @default(cuid())
  contractId String                 @unique
  contract   Contract               @relation(fields: [contractId], references: [id], onDelete: Cascade)
  steps      ContractApprovalStep[]
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
}

model ContractApprovalStep {
  id             String               @id @default(cuid())
  approvalLineId String
  approvalLine   ContractApprovalLine @relation(fields: [approvalLineId], references: [id], onDelete: Cascade)
  order          Int
  approverId     String
  approver       User                 @relation("ContractApprover", fields: [approverId], references: [id])
  status         ApprovalStepStatus   @default(WAITING)
  comment        String?
  signatureUrl   String? // 손글씨 서명 이미지 (PNG)
  decidedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([approvalLineId, order])
  @@index([approverId, status])
}

// ─── 결재 라인 ──────────────────────────────────────────────
model ApprovalLine {
  id        String             @id @default(cuid())
  userId    String
  purpose   String             @default("LEAVE_2PLUS") // CONTRACT(전자계약) | LEAVE_2PLUS(연차2일+) | LEAVE_SHORT(단기휴가)
  user      User               @relation("ApprovalLineTarget", fields: [userId], references: [id])
  steps     ApprovalLineStep[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([userId, purpose])
}

model ApprovalLineStep {
  id             String       @id @default(cuid())
  approvalLineId String
  approvalLine   ApprovalLine @relation(fields: [approvalLineId], references: [id], onDelete: Cascade)
  order          Int
  approverId     String
  approver       User         @relation("ApprovalLineApprover", fields: [approverId], references: [id])

  @@unique([approvalLineId, order])
}

// ─── 휴가 결재 현황 ──────────────────────────────────────────
model LeaveApprovalStep {
  id             String             @id @default(cuid())
  leaveRequestId String
  leaveRequest   LeaveRequest       @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  order          Int
  approverId     String? // 실제 결재한 사람(역할기반 단계는 승인 시 기록). null=아직 미결
  approver       User?              @relation("LeaveApprovalApprover", fields: [approverId], references: [id])
  approverRole   String? // 이 단계를 결재할 역할: MANAGER | ADMIN (역할 기반 정책)
  branch         String? // MANAGER 단계일 때 해당 지점
  status         ApprovalStepStatus @default(PENDING)
  comment        String?
  decidedAt      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([leaveRequestId, order])
  @@index([approverId, status])
}

enum ApprovalStepStatus {
  WAITING
  PENDING
  APPROVED
  REJECTED
}

// ─── 계약 템플릿 ──────────────────────────────────────────────
model ContractTemplate {
  id            String       @id @default(cuid())
  name          String       @unique // "2025 신입사원 근로계약서"
  description   String?
  type          ContractType
  fileUrl       String
  version       Int          @default(1)
  isActive      Boolean      @default(true)
  createdBy     String
  createdByUser User         @relation("TemplateCreator", fields: [createdBy], references: [id])
  approverIds   String       @default("[]") // JSON array: ["id1", "id2"]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  contracts Contract[] @relation("TemplateToContract")

  @@index([type])
  @@index([isActive, type])
}

// ─── 계약 버전 관리 ───────────────────────────────────────────
model ContractVersion {
  id            String         @id @default(cuid())
  contractId    String
  contract      Contract       @relation(fields: [contractId], references: [id], onDelete: Cascade)
  version       Int
  fileUrl       String
  title         String
  type          ContractType
  status        ContractStatus
  startDate     DateTime?      @db.Date
  endDate       DateTime?      @db.Date
  createdBy     String
  createdByUser User           @relation("VersionCreator", fields: [createdBy], references: [id])
  createdAt     DateTime       @default(now())

  @@unique([contractId, version])
  @@index([contractId, version])
}

// ─── 지점 ───────────────────────────────────────────────────
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  latitude  Float?
  longitude Float?
  radius    Int      @default(100)
  isActive  Boolean  @default(true)
  countInStats Boolean @default(true) // 대시보드 통계(직원·원장·지점 수)에 포함 여부 (테스트지점·본부 등 제외용)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── 감사 로그 (관리자 변경 이력) ─────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String // 행위자(관리자) id
  actorName  String // 행위자 이름(스냅샷)
  action     String // LEAVE_BALANCE_UPDATE | EMPLOYEE_UPDATE | EMPLOYEE_CREATE | EMPLOYEE_DELETE | EMPLOYEE_RESIGN | EMPLOYEE_RESTORE | EMPLOYEE_RESET_PW | LEAVE_DECISION | SCHEDULE_DECISION
  targetType String? // USER | LEAVE | SCHEDULE
  targetId   String?
  targetName String? // 대상 이름(스냅샷)
  detail     String? // 사람이 읽는 요약 (예: "연차 15→18일")
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// ─── 시프티워크: 채팅 ─────────────────────────────────────────
model WorkChannel {
  id        String              @id @default(cuid())
  name      String
  type      WorkChannelType     @default(CHANNEL)
  isDefault Boolean             @default(false) // 전체 채널 등 기본 채널
  hidden    Boolean             @default(false) // 회의 전용 채널 등 목록에서 숨김
  createdBy String?
  createdAt DateTime            @default(now())
  deletedAt DateTime? // 소프트 삭제(휴지통)
  permanentlyDeletedAt DateTime? // 영구 삭제 예정일(삭제 후 30일)
  labelText String? // # 대신 표시할 라벨 텍스트(예: 지점)
  labelColor String? // 라벨 배경색(hex)
  // 채널 고정 공지 (카카오워크식 — 채팅 상단 배너)
  noticeContent   String?
  noticeImageUrl  String? // 이미지 공지 (이미지 메시지를 공지로 등록)
  noticeBy        String? // 등록자 이름
  noticeAt        DateTime?
  noticeImportant Boolean   @default(false) // 중요 공지: 즉시 푸시 + 매일 9시 미확인자 재푸시
  members   WorkChannelMember[]
  messages  WorkMessage[]
  polls     WorkPoll[]
  scheduledMessages WorkScheduledMessage[]

  @@index([type])
}

// 큐브티 봇 브리핑 설정 — 관리자가 여러 개 만들 수 있고 각각 발송 채널/주기/시간/포함 항목/첨부를 가진다
model BotBriefing {
  id           String    @id @default(cuid())
  name         String // 예: "아침 브리핑"
  folder       String? // 관리용 폴더 (null = 미분류. 예: "지점별", "TM", "원장")
  time         String // KST "HH:mm" (예: "09:00")
  repeat       String    @default("DAILY") // DAILY | WEEKLY | MONTHLY | YEARLY
  repeatValue  String? // WEEKLY: "1,2,3"(0=일~6=토 csv) / MONTHLY: "15"(일자) / YEARLY: "03-02"(MM-DD)
  channelId    String? // 발송 채널 (null = 전체 채널)
  branch       String? // 대상 범위 (null = 전사, 값 = 해당 지점 구성원만)
  enabled      Boolean   @default(true)
  showLeaves   Boolean   @default(true) // 오늘 휴가자
  showEvents   Boolean   @default(true) // 오늘 일정(캘린더)
  showAnniv    Boolean   @default(true) // 입사기념일
  showBirthday Boolean   @default(false) // 오늘 생일 (User.birthDate 필요)
  customText   String? // 항상 포함할 커스텀 문구 (여러 줄)
  attachments  Json? // [{url,name,type}] — 브리핑과 함께 발송할 이미지/파일
  monthlyAttach Boolean @default(false) // 첨부 파일명에서 월을 읽어 해당 월 파일만 발송 (12개월치 카드뉴스 일괄 등록용)
  lastSentAt   DateTime? // 멱등 처리용 (KST 같은 날 중복 발송 방지)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// 대용량 영상 자동 압축 큐 — 100MB 초과 영상을 백그라운드에서 1080p(H.264)로 변환해 저장공간 절약
model VideoCompressJob {
  id        String   @id @default(cuid())
  fileUrl   String   @unique // 원본 /api/uploads/work/xxx
  status    String   @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED(효과 없음·참조 없음 → 원본 유지)
  origSize  Int // bytes
  newSize   Int?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 원장 겸직 지점 — User.branch(대표 지점) 외에 추가로 담당하는 지점 (MANAGER 전용)
// 원장의 팀 조회·결재 라우팅은 대표+겸직 지점을 합쳐서 본다 (lib/manager-branches.ts)
model ManagerBranch {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchName String // Branch.name 문자열 매핑 (User.branch와 동일 규칙, FK 아님)

  @@unique([userId, branchName])
}

// 공휴일 — 휴가 일수 계산·지각/조퇴 판정의 유일한 진실 소스
// (2026~2027 정적 시드 + 관리자 편집. 임시공휴일은 관리자가 추가)
model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

// 앱 전역 설정 (키-값) — 예: forceApprovalNotify(결재 알림 강제발송)
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// 시스템 에러 로그 — API 오류를 기록해 관리자 페이지에서 원인 추적 (14일 보관 후 자동 삭제)
model SystemErrorLog {
  id        String   @id @default(cuid())
  path      String // 예: "/api/work/channels/xxx/messages"
  method    String? // GET/POST 등
  userName  String? // 요청자 (알 수 있는 경우)
  message   String
  stack     String?
  resolved   Boolean   @default(false) // 관리자가 확인·조치 완료 표시
  resolvedBy String? // 처리자 이름
  resolvedAt DateTime?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// 예약 전송 메시지 — sendAt 도래 시 스케줄러가 작성자 명의로 채널에 게시
model WorkScheduledMessage {
  id         String      @id @default(cuid())
  channelId  String
  channel    WorkChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content    String
  sendAt     DateTime
  sentAt     DateTime?
  canceledAt DateTime?
  createdAt  DateTime    @default(now())

  @@index([sentAt, sendAt])
}

// 메시지 리마인더 — remindAt 도래 시 봇 DM으로 다시 알림
model WorkReminder {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   WorkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  sentAt    DateTime?
  createdAt DateTime    @default(now())

  @@index([sentAt, remindAt])
}

// 메시지 북마크 (개인 보관함)
model WorkBookmark {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String
  message   WorkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, messageId])
}

// 채널 투표 (카카오워크식). 메시지 버블(WorkMessage.pollId)로 노출된다.
model WorkPoll {
  id          String         @id @default(cuid())
  channelId   String
  channel     WorkChannel    @relation(fields: [channelId], references: [id], onDelete: Cascade)
  creatorId   String
  creatorName String // 표시용 (User 관계 없이 비정규화)
  question    String
  options     Json // string[]
  multiple    Boolean        @default(false)
  closedAt    DateTime?
  closesAt    DateTime? // 종료 예정 일시 — 도래 시 봇 스케줄러가 자동 마감 + 채팅 알림
  createdAt   DateTime       @default(now())
  votes       WorkPollVote[]
  messages    WorkMessage[]
}

model WorkPollVote {
  id          String   @id @default(cuid())
  pollId      String
  poll        WorkPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)
  userId      String
  optionIndex Int

  @@unique([pollId, userId, optionIndex])
}

enum WorkChannelType {
  CHANNEL // 공개/그룹 채널
  DM // 1:1 다이렉트 메시지
}

model WorkChannelMember {
  id        String      @id @default(cuid())
  channelId String
  channel   WorkChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?
  notify    WorkNotify  @default(ALL) // 채널 알림 설정
  pinned    Boolean     @default(false) // 사용자별 채널 상단 고정
  hiddenAt  DateTime? // DM '나만 숨기기' 시점(null=보임). 이 시점 이후 새 메시지 오면 다시 노출
  historyFrom DateTime? // 이 시점 이후 메시지만 열람(null=전체). 멤버 추가 시 과거기록 노출 범위
  isManager Boolean     @default(false) // 방장(생성자가 위임). 인원 추가/내보내기/이름변경 가능
  joinedAt  DateTime    @default(now())

  @@unique([channelId, userId])
  @@index([userId])
}

enum WorkNotify {
  ALL // 모든 메시지
  MENTION // 멘션만
  MUTE // 음소거
}

model WorkMessage {
  id        String      @id @default(cuid())
  channelId String
  channel   WorkChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String      @default("")
  // 첨부파일 (선택)
  fileUrl   String?
  fileName  String?
  fileType  String? // image | video | file
  albumUrls Json? // 사진 앨범(여러 장 묶음 전송) — 이미지 URL 배열
  // 댓글(스레드): 부모 메시지
  parentId  String?
  parent    WorkMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   WorkMessage[] @relation("MessageReplies")
  // 인용 답장: 이 메시지가 답장한 대상
  replyToId String?
  replyTo   WorkMessage?  @relation("MessageQuote", fields: [replyToId], references: [id], onDelete: SetNull)
  quotedBy  WorkMessage[] @relation("MessageQuote")
  editedAt  DateTime? // 수정됨 표시
  deletedAt DateTime? // 메시지 삭제(되돌리기) — 내용 숨기고 "삭제된 메시지" 표시
  system    Boolean     @default(false) // 시스템 알림(이름 변경 등) — 중앙 회색 문구로 렌더
  // 투표 메시지: pollId가 있으면 버블을 투표 카드로 렌더
  pollId    String?
  poll      WorkPoll?   @relation(fields: [pollId], references: [id], onDelete: SetNull)
  reactions WorkMessageReaction[]
  bookmarks WorkBookmark[]
  reminders WorkReminder[]
  createdAt DateTime    @default(now())

  @@index([channelId, createdAt])
  @@index([parentId])
}

model WorkMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  message   WorkMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// ─── 모바일 푸시 알림 토큰 ────────────────────────────────────
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique // Expo Push Token (ExponentPushToken[...])
  platform  String? // ios | android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── 시프티워크: 회사/지점 전체 일정 캘린더 ────────────────────
model WorkCalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String?
  startDate   DateTime @db.Date
  endDate     DateTime @db.Date
  branch       String? // null = 전사 공통, 값 있으면 해당 지점 전용
  managersOnly Boolean  @default(false) // 원장 전용 일정 (원장·관리자만 조회, 직원 비노출)
  color        String   @default("indigo")
  createdBy    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
}

// ─── 시프티워크: 공지 ─────────────────────────────────────────
model WorkAnnouncement {
  id          String   @id @default(cuid())
  title       String
  content     String
  pinned      Boolean  @default(false)
  attachments String   @default("[]") // JSON: [{url,name,type}]
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

// ─── 시프티워크: 화상회의 ─────────────────────────────────────
model WorkMeeting {
  id        String    @id @default(cuid())
  room      String    @unique // Jitsi 방 이름
  title     String
  channelId String? // 회의 전용 사이드 채팅 채널
  createdBy String
  createdAt DateTime  @default(now())
  lastJoinedAt DateTime? // 마지막 입장 시각(자동 종료 판단용)
  endedAt   DateTime?
  invites   WorkMeetingInvite[]

  @@index([endedAt])
}

// 회의 초대 명단 — 개설자/초대받은 사람(+관리자)만 진행 중 회의를 보고 참여할 수 있다
model WorkMeetingInvite {
  id        String      @id @default(cuid())
  meetingId String
  meeting   WorkMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime    @default(now())

  @@unique([meetingId, userId])
}

// 회의 녹화본 (회의 종료 후에도 보존)
model WorkMeetingRecording {
  id           String   @id @default(cuid())
  meetingTitle String
  room         String
  fileUrl      String
  fileName     String
  sizeBytes    Int      @default(0)
  createdBy    String
  createdAt    DateTime @default(now())

  @@index([createdAt])
}
