{
  "expo": {
    "name": "큐브티",
    "slug": "mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/60c598b7-06ce-46b5-a11b-e1759c12b689"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "사진을 채팅에 첨부하기 위해 사진 보관함 접근이 필요합니다."
        }
      ],
      "expo-notifications",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "음성 메시지를 녹음하기 위해 마이크 접근이 필요합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "받은 사진을 사진첩에 저장하기 위해 접근 권한이 필요합니다.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "출퇴근 기록 시 지점 위치 확인을 위해 현재 위치가 필요합니다. 출근/퇴근 버튼을 누르는 순간에만 사용되며 상시 추적하지 않습니다."
        }
      ],
      "@sentry/react-native"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.co.cubetee.app",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "kr.co.cubetee.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "60c598b7-06ce-46b5-a11b-e1759c12b689"
      },
      "sentryDsn": "https://4405917f10c932212345bd644c0e37b4@o4511738233225216.ingest.us.sentry.io/4511738296401920"
    }
