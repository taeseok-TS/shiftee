# ─────────────────────────────────────────────────────────────
#  큐브티 설치 정보
#
#  이 파일에 값을 채워 보내주시면 그대로 설치됩니다.
#  모르는 항목은 비워두셔도 됩니다 — 저희가 기본값으로 채우고 나중에 함께 정합니다.
#
#  설치:  bash new-customer.sh --config customer.conf
# ─────────────────────────────────────────────────────────────


# ── 꼭 필요한 것 ─────────────────────────────────────────────

# 회사명 (화면에 표시되지는 않습니다. 저희가 구분하는 용도예요)
company=에이스산업

# 식별 코드 — 영문 소문자·숫자·하이픈만.
# 주소에 쓰입니다. 예: acme  →  https://acme.cubetee.co.kr
code=acme

# 관리자 (첫 로그인 계정입니다. 나중에 직원은 화면에서 추가하시면 됩니다)
admin_name=홍길동
admin_email=admin@acme.co.kr

# 지점 이름 — 쉼표로 구분해 전부 적어주세요.
# 지점이 하나면 하나만 적으시면 됩니다.
branches=본점,강남점,분당점


# ── 있으면 좋은 것 (비워두셔도 됩니다) ───────────────────────

# 쓰실 도메인이 있으면 적어주세요. 그 주소로 접속하게 해드립니다.
# 비워두면 https://<코드>.cubetee.co.kr 을 쓰고, 나중에 바꿀 수 있습니다.
# ※ 직접 도메인을 쓰시려면 그 도메인의 A 레코드를 저희 서버로 향하게 해주셔야 합니다.
domain=

# 대략 직원 수 — 서버 사양을 정하는 데만 씁니다. 설치에는 영향이 없습니다.
employees=45


# ── 저희가 정하는 값 (건드리지 않으셔도 됩니다) ──────────────

# 내부 포트. 비워두면 빈 번호를 자동으로 찾아 씁니다.
port=

# 워드->PDF 변환에 쓰는 한글 폰트 폴더(서버 경로). 비워두면 서버의 공용 폴더를 찾아 씁니다.
# 못 찾으면 설치는 되지만 계약서 PDF 서식이 명조로 폴백돼 어긋납니다.
# 환경변수 CUBETEE_FONTS_DIR 로도 지정할 수 있습니다.
fonts_dir=


# ─────────────────────────────────────────────────────────────
#  설치 후 함께 정할 것들
#
#  아래는 값만으로는 정할 수 없어서, 오픈 전에 같이 확인합니다.
#  미리 알려주시면 더 빠릅니다.
#
#  1. 지점 위치 — 출퇴근이 GPS로 찍힙니다.
#     주소만으로는 부정확해서(주차장·건물 안쪽 차이로 출근이 안 찍힙니다)
#     지점마다 실제 위치와 인정 반경을 함께 확인합니다.
#
#  2. 근무·휴가 규정
#     · 휴가를 누가 승인하나요? (지점장 → 본사, 또는 본사만 등)
#     · 연차는 어떤 기준인가요? (입사일 기준 / 회계연도 기준)
#     · 주말 근무는 사전 승인이 필요한가요?
#
#  3. 알림 메일 발신 주소
#     휴가 승인 같은 알림이 나갈 주소입니다. 회사 도메인을 쓰시려면
#     메일 인증 설정이 필요해서 담당자분과 한 번 확인이 필요합니다.
# ─────────────────────────────────────────────────────────────
