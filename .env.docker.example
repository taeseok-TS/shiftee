# ─────────────────────────────────────────────────────────────
# 큐브티 배포용 환경변수 예시.
# 이 파일을 복사해서 .env 로 만들고 실제 값으로 채우세요:
#   cp .env.docker.example .env
# docker compose 가 같은 폴더의 .env 를 자동으로 읽습니다.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (컨테이너 내부 DB)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=여기에_강력한_비밀번호
POSTGRES_DB=shiftee

# JWT 시크릿 (최소 32자 랜덤 문자열)
#   생성 예: openssl rand -base64 48
JWT_SECRET=여기에_랜덤_시크릿_최소_32자

# 외부에서 접속할 실제 주소 (도메인 또는 서버 IP)
NEXT_PUBLIC_APP_URL=https://cubetee.example.com
NEXT_PUBLIC_API_URL=https://cubetee.example.com/api

# 이메일 발송(SMTP). 전자계약 서명 요청·휴가 결재 메일이 이 설정으로 나갑니다.
# 비워 두면 메일은 발송되지 않고 경고 로그만 남습니다(봇 DM은 영향 없음).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=앱비밀번호
# 수신자에게 보이는 발신자. FROM_EMAIL 을 비우면 SMTP_USER 주소로 나갑니다.
# ⚠️ Gmail 은 인증 계정(또는 등록된 별칭)이 아닌 주소를 쓰면 From 을 임의로 덮어씁니다.
# SMTP_FROM_NAME=큐브티
# SMTP_FROM_EMAIL=no-reply@cubetee.co.kr

# 업로드 파일 접근 게이트 (쉼표 구분). 이 경로군은 로그인 세션 또는 접근 티켓이 있어야 열린다.
# 비워 두면 signatures,contracts 가 적용된다. 게이트를 끄려면 off.
# work(채팅 첨부) 추가는 앱 확산 확인 + 채널 멤버십 판정이 선행돼야 한다 (2026-09-02 사고).
UPLOADS_GATE=signatures,contracts
