# PostgreSQL 연결 주소
DATABASE_URL="postgresql://postgres:password@localhost:5432/shiftee"

# JWT 시크릿 (최소 32자 이상 랜덤 문자열)
JWT_SECRET="your-super-secret-jwt-key-change-this"

# 파일 업로드 저장 경로
UPLOAD_DIR="./uploads"

# Next.js 앱 URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# API 서버 URL (모바일 앱에서 사용)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# 업로드 파일 접근 게이트 (쉼표 구분). 이 경로군은 로그인 세션 또는 접근 티켓이 있어야 열린다.
# 비워 두면 signatures,contracts 가 적용된다. 게이트를 끄려면 off.
# work(채팅 첨부) 추가는 앱 확산 확인 + 채널 멤버십 판정이 선행돼야 한다 (2026-09-02 사고).
UPLOADS_GATE=signatures,contracts

# 프록시(Caddy) 접근 로그 경로. 실패 응답(4xx.5xx)을 하루 한 번 집계해 관리자에게 알린다.
# 비우면 이 기능이 꺼진다. 컨테이너 안 경로이며 compose 에서 읽기전용으로 마운트한다.
ACCESS_LOG_PATH=/var/log/caddy/cubetee.log
